#%RAML 1.0 Library

traits:
  standardResponse:
    responses:
      200:
        description: Success
      400:
        description: Bad Request
        body:
          application/json:
            example:
              message: "Bad request"
      404:
        description: Not Found
        body:
          application/json:
            example:
              message: "Resource not found"
      500:
        description: Internal Server Error
        body:
          application/json:
            example:
              message: "Internal server error"

  jsonBody:
    body:
      application/json:

  securityHeaders:
    headers:
      X-Correlation-ID:
        type: string
        required: false
        description: Correlation ID for request tracking
      Authorization:
        type: string
        required: false
        description: Authorization header

  rateLimited:
    responses:
      429:
        description: Too Many Requests
        body:
          application/json:
            example:
              message: "Rate limit exceeded"
