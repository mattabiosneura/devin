#%RAML 1.0
title: Sample API
version: v1
baseUri: /sampleapi

uses:
  DataTypes: libraries/data-types.raml
  Traits: libraries/traits.raml

/createUser:
  post:
    description: Create a new user
    is: [Traits.jsonBody, Traits.standardResponse]
    body:
      application/json:
        type: DataTypes.UserRequest

/product:
  post:
    description: Calculate product value
    is: [Traits.jsonBody, Traits.standardResponse]
    body:
      application/json:
        type: DataTypes.ProductRequest
    responses:
      200:
        body:
          application/json:
            type: DataTypes.ProductResponse

/complexProduct:
  post:
    description: Calculate complex product with conditional logic
    is: [Traits.jsonBody, Traits.standardResponse]
    body:
      application/json:
        type: DataTypes.ComplexProductRequest
    responses:
      200:
        body:
          application/json:
            type: DataTypes.ComplexProductResponse
